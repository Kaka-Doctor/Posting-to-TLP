# ── Database ────────────────────────────────────────────────────────────────
# Local: SQLite file (created automatically). On Vercel/Netlify leave this
# unset — the app falls back to a temp database and rebuilds itself from data/.
DATABASE_URL=file:./db/custom.db

# ── Meta (Facebook Page + Instagram) ────────────────────────────────────────
# Get these from developers.facebook.com → your app → Graph API Explorer.
# Alternatively (private repo): keep them in data/config.json — committed.
META_ACCESS_TOKEN=your-facebook-access-token
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret

# ── Optional ────────────────────────────────────────────────────────────────
# Public URL of this deployment (auto-captured on first dashboard visit if unset)
# PUBLIC_BASE_URL=https://your-app.vercel.app
# Protect /api/cron with a secret (then call /api/cron?secret=YOUR_SECRET)
# CRON_SECRET=choose-a-long-random-string
# Duplicate-post guard window in minutes on serverless (default 30)
# DEDUP_GUARD_MINUTES=30
